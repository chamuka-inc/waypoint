{
  "name": "waypoint-career",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal career research desktop application powered by Codex and TypeSafe Jev",
  "author": "Chamuka Inc.",
  "homepage": "https://chamuka-inc.github.io/waypoint/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamuka-inc/waypoint.git"
  },
  "scripts": {
    "dev": "node --import tsx server/preview.ts",
    "preview": "node --import tsx server/preview.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "build:desktop:web": "electrobun prepare && vite build --config vite.electrobun.config.ts",
    "start": "npm run build:desktop:web && electrobun dev",
    "desktop": "npm start",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build:desktop:web && electrobun build --env=stable",
    "dist": "npm run package",
    "test:ui": "node --import tsx scripts/verify-ui.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "lucide": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electrobun": "2.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
