{
  "name": "waypoint-career",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal career research desktop application powered by Codex and TypeSafe Jev",
  "author": "Chamuka Inc.",
  "homepage": "https://chamuka-inc.github.io/waypoint/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamuka-inc/waypoint.git"
  },
  "main": "dist-server/electron/main.js",
  "scripts": {
    "dev": "node --import tsx server/preview.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:ui": "node --import tsx scripts/verify-ui.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "lucide": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "app.waypoint.career",
    "productName": "Waypoint",
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
