{
  "name": "waypoint-career",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "A personal career research desktop application powered by Codex and TypeSafe Jev",
  "author": "Chamuka Inc.",
  "homepage": "https://chamuka-inc.github.io/waypoint/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamuka-inc/waypoint.git"
  },
  "scripts": {
    "dev": "node --import tsx server/preview.ts",
    "dev:wails": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 dev",
    "desktop": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 dev",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:go": "go test ./...",
    "package": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 build -clean",
    "dist": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 build -clean",
    "test:ui": "node --import tsx scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.17.1",
    "docx": "^9.7.1",
    "lucide": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
